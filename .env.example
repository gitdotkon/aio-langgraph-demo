# OpenAI 兼容接口配置（OpenRouter / 火山方舟 / DeepSeek 均可）
OPENAI_API_KEY=sk-xxxxx
OPENAI_MODEL_ID=anthropic/claude-sonnet-4
OPENAI_BASEURL=https://openrouter.ai/api/v1

# AIO Sandbox 地址（本地 docker 默认 8080）
# 沙箱连不通时 agent 自动降级到本地 runtime（LocalShellBackend），见下方探测配置
SANDBOX_URL=http://konmini.local:8080

# 沙箱连通性探测超时（秒）
SANDBOX_PROBE_TIMEOUT=3
# 降级模式的本地工作区（默认项目下 ./local_workspace）
# LOCAL_WORKSPACE_DIR=./local_workspace
